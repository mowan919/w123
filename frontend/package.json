{
  "name": "vctn-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VCTN 后台管理平台前端（Vue 3 + TypeScript + Vite + Vue Router + Pinia）",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "naive-ui": "^2.45.3",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "9.33.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
