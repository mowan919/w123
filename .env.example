# ===========================================================================
# VCTN 环境变量样例
#
# 用法：复制为 .env 后按环境填写。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，禁止把真实凭据提交到版本库。
#       Spec 13 §2：DB password / Redis password / signing secret /
#       encryption key / MFA encryption key 不得硬编码。
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=VCTN
# local | dev | test | staging | prod
APP_ENV=local
DEBUG=false

# Spec 08 §1：Base 路径
API_V1_PREFIX=/api/v1/admin

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = 结构化 JSON 日志（生产）；false = 可读文本（本地调试）
LOG_JSON=true

# ---------------------------------------------------------------------------
# PostgreSQL
# 本地开发不安装实例，指向可用的数据库地址即可。
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=vctn
POSTGRES_PASSWORD=
POSTGRES_DB=vctn

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis
# UNRESOLVED DESIGN DECISION：Redis Key 命名规范尚未冻结，此处仅连接配置。
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5

# ---------------------------------------------------------------------------
# Snowflake —— DD-14 技术参数未冻结，以下为保守默认值，可覆盖
# Frozen 部分（不可修改）：BIGINT 主键 / API JSON 字符串 / 禁止自增 / 禁止 UUID
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1
# 2025-01-01T00:00:00Z
SNOWFLAKE_EPOCH_MS=1735689600000

# ---------------------------------------------------------------------------
# Secrets —— Phase 3 / 4 / 5 使用，本阶段留空
# 生产环境（APP_ENV=prod）留空会导致启动失败（fail-closed）
# ---------------------------------------------------------------------------
SIGNING_SECRET=
ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Docker Compose 镜像标签 —— DD-18 未冻结，可在此覆盖
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
