# ===========================================================================
# VCTN 环境变量样例
#
# 用法：复制为 .env 后按环境填写。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，禁止把真实凭据提交到版本库。
#       Spec 13 §2：DB password / Redis password / signing secret /
#       encryption key / MFA encryption key 不得硬编码。
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=VCTN
# local | dev | test | staging | prod
APP_ENV=local
DEBUG=false

# Spec 08 §1：Base 路径
API_V1_PREFIX=/api/v1/admin

# ---------------------------------------------------------------------------
# Authentication —— Phase 4
# ---------------------------------------------------------------------------
# 认证端点的前缀。**刻意与 API_V1_PREFIX 分开**：
# 登录 / 刷新 / 登出是"取得身份"的入口，而 /api/v1/admin 之下的一切
# 都要求"已经取得身份"，两者混在一起会让后续的权限守卫
# 误把登录端点也纳入拦截范围。已在 docs/DESIGN-DECISIONS.md INTERIM-4-01 登记。
AUTH_V1_PREFIX=/api/v1/auth

# MFA 的**系统级**兜底策略（Spec 04 §7 的 user > role > system 中最底层）。
# false = 默认不要求二次验证（Phase 4 尚无具体 Provider，DD-01 方案 A）。
# ⚠️ 置为 true 时，若没有注册任何可用 Provider，登录会**明确失败**（fail-closed）——
#    这是刻意的：宁可让配置缺失立刻可见，也不放行一个"号称有 MFA、实际没有"的系统。
# user / role 两级的策略存储属 Phase 5。
MFA_REQUIRED_DEFAULT=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = 结构化 JSON 日志（生产）；false = 可读文本（本地调试）
LOG_JSON=true

# ---------------------------------------------------------------------------
# PostgreSQL
# 本地开发不安装实例，指向可用的数据库地址即可。
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=vctn
POSTGRES_PASSWORD=
POSTGRES_DB=vctn

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis
# UNRESOLVED DESIGN DECISION：Redis Key 命名规范尚未冻结，此处仅连接配置。
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5

# ---------------------------------------------------------------------------
# Snowflake —— DD-14 技术参数未冻结，以下为保守默认值，可覆盖
# Frozen 部分（不可修改）：BIGINT 主键 / API JSON 字符串 / 禁止自增 / 禁止 UUID
# ---------------------------------------------------------------------------
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1
# 2025-01-01T00:00:00Z
SNOWFLAKE_EPOCH_MS=1735689600000

# ---------------------------------------------------------------------------
# Secrets —— Phase 3 / 4 / 5 使用，本阶段留空
# 生产环境（APP_ENV=prod）留空会导致启动失败（fail-closed）
# ---------------------------------------------------------------------------
SIGNING_SECRET=
ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Docker Compose 镜像标签 —— DD-18 未冻结，可在此覆盖
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
